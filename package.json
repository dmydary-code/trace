{
  "name": "trace-review",
  "version": "0.5.3",
  "description": "Local code review with dependency graphs and threaded feedback for Codex and Claude Code",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "trace": "bin/trace.mjs",
    "trace-review": "bin/trace.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/integration/*.test.mjs",
    "start": "node bin/trace.mjs",
    "sync-versions": "node scripts/sync-plugin-versions.mjs",
    "version": "node scripts/sync-plugin-versions.mjs && git add plugins/trace/.claude-plugin/plugin.json plugins/trace/.codex-plugin/plugin.json",
    "test:browser": "playwright test",
    "test:acceptance": "node --test tests/acceptance/*.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:browser:acceptance": "TRACE_ACCEPTANCE=1 playwright test --grep @acceptance --pass-with-no-tests",
    "test:live": "node scripts/live-agent-acceptance.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
